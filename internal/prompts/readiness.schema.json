{
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["ready", "blocked"]},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {"type": "string", "description": "A fact you need that neither the task nor the repository holds."},
          "suggested_answer": {"type": "string", "description": "The answer you would assume if nobody answered."}
        },
        "required": ["question", "suggested_answer"]
      }
    }
  },
  "required": ["status"],
  "if": {"properties": {"status": {"const": "blocked"}}},
  "then": {"required": ["questions"], "properties": {"questions": {"type": "array", "minItems": 1}}}
}
